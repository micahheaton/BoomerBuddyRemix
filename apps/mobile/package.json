{
  "name": "@boomerbuddy/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "expo-doctor",
    "assets:check": "node ../../scripts/generate-mobile-assets.mjs --check",
    "verify:distribution": "node ../../scripts/verify-mobile-distribution.mjs"
  },
  "dependencies": {
    "@boomerbuddy/contracts": "*",
    "@boomerbuddy/design": "*",
    "@boomerbuddy/security": "*",
    "@clerk/expo": "4.6.0",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.8",
    "expo": "~57.0.18",
    "expo-auth-session": "~57.0.10",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-notifications": "~57.0.14",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "expo-doctor": "1.20.2"
  }
