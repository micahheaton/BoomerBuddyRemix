{
  "expo": {
    "name": "BoomerBuddy",
    "slug": "boomerbuddy-2-local",
    "scheme": "boomerbuddy-local",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.boomerbuddy.local"
    },
    "android": {
      "package": "net.boomerbuddy.local"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-secure-store"],
    "extra": {
      "deepLinkStatus": "scaffolded_not_device_verified",
      "nativeSharingStatus": "blocked_not_device_verified",
      "providerMode": "local_unknown"
    }
  }
}
