# Known local-development values only. Production must reject these defaults.
NODE_ENV=development
BB_API_HOST=127.0.0.1
BB_API_PORT=4000
BB_DATABASE_DRIVER=pglite
BB_PGLITE_PATH=.data/boomerbuddy
BB_RUN_MIGRATIONS=true
BB_SEED_DEMO=false
BB_ALLOW_DEV_IDENTITY=true
BB_CUSTOMER_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
BB_HQ_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
BB_SESSION_SECRET=local-browser-session-secret-not-for-production
BB_ARTIFACT_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BB_FINGERPRINT_KEY_BASE64=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
BB_SAFE_WORD_PEPPER=local-safe-word-pepper-not-for-production
BB_LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
