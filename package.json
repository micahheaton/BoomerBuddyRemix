{
  "name": "boomerbuddy-2",
  "version": "0.1.0",
  "private": true,
  "description": "Trust-first household scam response foundation",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "react-native": "0.86.3"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,hq -c blue,green,magenta \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:hq\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm run dev -w @boomerbuddy/web",
    "dev:hq": "npm run dev -w @boomerbuddy/hq",
    "dev:mobile": "npm run dev -w @boomerbuddy/mobile",
    "mobile:assets": "node scripts/generate-mobile-assets.mjs",
    "mobile:assets:check": "node scripts/generate-mobile-assets.mjs --check",
    "mobile:verify-distribution": "node scripts/verify-mobile-distribution.mjs",
    "dev:worker": "npm run dev -w @boomerbuddy/worker",
    "build": "npm run typecheck && npm run build -w @boomerbuddy/api && npm run build -w @boomerbuddy/worker && npm run build -w @boomerbuddy/web && npm run build -w @boomerbuddy/hq && npm run build -w @boomerbuddy/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx scripts/run-sql-migrations.ts",
    "db:seed": "tsx scripts/seed-local.ts",
    "identity:bootstrap-founder": "tsx scripts/bootstrap-production-founder.ts",
    "identity:disable": "tsx scripts/disable-production-identity.ts",
    "founding-household:bootstrap-production": "tsx scripts/bootstrap-founding-household-production.ts",
    "run3-1:backup": "tsx scripts/run3-1-database-portability.ts backup",
    "run3-1:restore": "tsx scripts/run3-1-database-portability.ts restore",
    "verify:postgres": "tsx scripts/verify-postgres.ts",
    "stripe:inventory:enqueue": "tsx scripts/enqueue-stripe-inventory.ts",
    "data:ncua": "tsx scripts/ingest-ncua-credit-unions.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run test:integration:shard:1 && npm run test:integration:shard:2",
    "test:integration:shard:1": "vitest run --project integration --shard=1/2",
    "test:integration:shard:2": "vitest run --project integration --shard=2/2",
    "test:security": "vitest run --project security",
    "test:eval": "tsx scripts/eval-report.ts",
    "test:e2e": "playwright test",
    "test:e2e:accessibility-matrix": "playwright test --config tests/e2e/accessibility.playwright.config.ts",
    "test:coverage": "vitest run --coverage --project unit",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "verify:runtime-deps": "node scripts/verify-runtime-dependency-scope.mjs",
    "verify:run3-1-deps": "node scripts/verify-run3-1-dependencies.mjs",
    "verify:production-auth-routes": "cross-env BB_PRODUCTION_AUTH_ROUTES_ONLY=true node scripts/verify-founding-household-production-ui.mjs",
    "verify:production-ui": "node scripts/verify-founding-household-production-ui.mjs",
    "verify:next-resource-auth": "node scripts/verify-next-resource-auth.mjs",
    "replit:build": "node scripts/replit-service.mjs build",
    "replit:start": "node scripts/replit-service.mjs start",
    "test": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:eval",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "npm run verify:secrets && npm run verify:runtime-deps && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run verify:production-ui && npm run verify:next-resource-auth"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wait-on": "9.1.0",
    "ws": "8.21.3"
  }
}
