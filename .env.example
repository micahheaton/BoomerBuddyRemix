# Known local-development values only. Production must reject these defaults.
NODE_ENV=development
# Replit automatically sets REPLIT_DEPLOYMENT=1 only in a published deployment.
# Set exactly one service selector per Replit project: web, api, worker, or hq.
# BB_REPLIT_SERVICE=api
# Every deployment must use the same immutable candidate. The tag suffix must match
# the first 12 characters of the exact full commit, and the checkout must be clean.
# BB_RUN3_1_RELEASE_COMMIT=0123456789abcdef0123456789abcdef01234567
# BB_RUN3_1_RELEASE_TAG=run3-1-replit-founding-household-0123456789ab
BB_API_HOST=127.0.0.1
BB_API_PORT=4000
# Keep 0 unless the exact reverse-proxy hop count has been reviewed; Public Check
# uses the resulting peer address only through a keyed, non-reversible HMAC bucket.
BB_TRUSTED_PROXY_HOPS=0
# Public private-beta access-intent receipt creation is default-off. Set both values to true only
# after the independently operated edge rate limit and kill switch have deployed proof. Setting
# ENABLED=false is the application kill switch; the edge kill switch remains independently usable.
BB_PRIVATE_BETA_ACCESS_INTENTS_ENABLED=false
BB_PRIVATE_BETA_ACCESS_INTENTS_EDGE_GUARD_CONFIRMED=false
BB_DATABASE_DRIVER=pglite
BB_PGLITE_PATH=.data/boomerbuddy
# Production PostgreSQL must use an explicit sslmode=require, verify-ca, or verify-full.
# Prefer verify-full when the provider supplies a trusted CA and hostname.
# DATABASE_URL=postgresql://user:password@host.example/boomerbuddy?sslmode=verify-full
# PostgreSQL only. Development/test preserve the code default of 10 when omitted. Production
# requires an explicit 1-10 cap; for the initial 0.25-CU beta use API=2, worker=1, migration=1.
# BB_POSTGRES_POOL_MAX=2
BB_RUN_MIGRATIONS=true
BB_SEED_DEMO=false
BB_ALLOW_DEV_IDENTITY=true
# BB_FOUNDER_PERSON_ID=person-founder-from-provisioned-identity
# Production only: exact immutable Clerk subject bound by identity:bootstrap-founder.
# BB_FOUNDER_CLERK_SUBJECT=user_founder_from_hq_clerk
BB_CUSTOMER_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
BB_HQ_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
# Web/HQ deployment only: the exact browser-visible origin for that project and the
# private HTTPS API deployment origin used by the same-origin /api proxy.
# BB_PUBLIC_ORIGIN=https://app.boomerbuddy.net
# BB_API_INTERNAL_ORIGIN=https://boomerbuddy-api.example.replit.app
# Web/HQ use separate Clerk applications with the same standard variable names in
# separate Replit projects. The publishable key is public; the secret key is a Secret.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Production web and HQ must both pin Clerk's server-side redirect to the local catch-all route.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Production requires separate customer and HQ Clerk applications, custom audiences,
# and networkless PEM verification keys. Authorized parties are the exact origin lists above.
# BB_CLERK_CUSTOMER_ISSUER=https://customer-instance.clerk.accounts.dev
# BB_CLERK_CUSTOMER_AUDIENCE=boomerbuddy-customer
# BB_CLERK_CUSTOMER_JWT_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
# Required in production. Use none until physical-device evidence proves Clerk emits a specific
# native azp; otherwise list only the exact observed HTTPS origin(s). Browser origins are refused.
# BB_CLERK_MOBILE_AUTHORIZED_PARTIES=none
# BB_CLERK_HQ_ISSUER=https://hq-instance.clerk.accounts.dev
# BB_CLERK_HQ_AUDIENCE=boomerbuddy-hq
# BB_CLERK_HQ_JWT_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
# BB_CLERK_HQ_MAX_SECOND_FACTOR_AGE_SECONDS=600
# Development/test only. Production rejects and does not load this unused signing material.
BB_SESSION_SECRET=local-browser-session-secret-not-for-production
BB_ARTIFACT_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BB_FINGERPRINT_KEY_BASE64=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
BB_SAFE_WORD_PEPPER=local-safe-word-pepper-not-for-production
BB_LOG_LEVEL=info
# Stripe defaults off. Live mode still requires exact database initiation and cohort controls.
# API version is code-owned and pinned to 2026-07-29.dahlia; do not configure it here.
BB_STRIPE_MODE=disabled
# BB_STRIPE_TEST_ACCOUNT_ID=
# BB_STRIPE_TEST_API_KEY=
# BB_STRIPE_TEST_WEBHOOK_SECRET=
# BB_STRIPE_TEST_FOUNDING_PRODUCT_ID=
# BB_STRIPE_TEST_FOUNDING_MONTHLY_PRICE_ID=
# BB_STRIPE_TEST_CANCEL_ONLY_PORTAL_CONFIGURATION_ID=
# Give each live Replit process exactly one surface and only that surface's restricted key family.
# Never use BB_STRIPE_LIVE_API_KEY or any sk_live key. Keep initiation false until the audited
# production cohort and initiation rows are deliberately opened.
# BB_STRIPE_LIVE_ACCOUNT_ID=
# BB_STRIPE_RUNTIME_SURFACE=api
# BB_STRIPE_LIVE_INITIATION_ENABLED=false
# BB_STRIPE_LIVE_API_RESTRICTED_KEY=
# BB_STRIPE_LIVE_WORKER_RESTRICTED_KEY=
# BB_STRIPE_LIVE_WEBHOOK_SECRET=
# BB_STRIPE_LIVE_FOUNDING_PRODUCT_ID=
# BB_STRIPE_LIVE_FOUNDING_MONTHLY_PRICE_ID=
# BB_STRIPE_LIVE_CANCEL_ONLY_PORTAL_CONFIGURATION_ID=
# Messaging is provider-free. These names are reserved documentation only; current config rejects
# every credential/URL value and any mode other than disabled.
BB_TWILIO_MODE=disabled
# BB_TWILIO_ACCOUNT_SID=
# BB_TWILIO_AUTH_TOKEN=
# BB_TWILIO_MESSAGING_SERVICE_SID=
# BB_TWILIO_TOLL_FREE_NUMBER_SID=
# BB_TWILIO_INBOUND_WEBHOOK_BASE_URL=
# BB_TWILIO_STATUS_CALLBACK_BASE_URL=
BB_WORKER_ID=worker-local-1
BB_WORKER_POLL_MS=1000
BB_WORKER_LEASE_MS=30000
BB_WORKER_HEARTBEAT_MS=10000
BB_WORKER_SHUTDOWN_MS=20000
# Local default is 10. The initial 0.25-CU production worker must set this to 1 so its claimed
# work matches the single-connection worker pool instead of creating a database-pressure queue.
BB_WORKER_BATCH_SIZE=10
BB_WORKER_RETRY_BASE_MS=1000
BB_WORKER_RETRY_MAX_MS=300000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# Mobile build-time public values. Configure EAS environments separately for
# development, preview, and production. Never place CLERK_SECRET_KEY in a mobile build.
# Production must use the customer Clerk instance's pk_live_ publishable key.
# That Clerk instance must define a 60-second JWT template named boomerbuddy-mobile
# with claims {"aud":"boomerbuddy-mobile","bb_surface":"mobile"} and 5-second skew.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_customer_publishable_key
# Production EAS builds pin this exact public API origin in apps/mobile/eas.json.
# EXPO_PUBLIC_API_URL=https://api.boomerbuddy.net
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Founder-machine backup/restore tooling only. Never add this to a web/API/worker/HQ
# deployment. Pass the outside-repository .bbbackup path and exact candidate SHA as
# CLI arguments to `npm run run3-1:backup -- ...` or `npm run run3-1:restore -- ...`.
# BB_RUN3_1_BACKUP_KEY_BASE64=<independent-32-byte-base64-key>
