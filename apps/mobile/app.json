{
  "expo": {
    "name": "BoomerBuddy",
    "slug": "boomerbuddy",
    "scheme": "boomerbuddy",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.boomerbuddy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "net.boomerbuddy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5EF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5EF"
        }
      ]
    ],
    "extra": {
      "deepLinkStatus": "route_only_registered_not_device_verified",
      "mobileJwtTemplate": "boomerbuddy-mobile",
      "nativeSharingStatus": "blocked_not_device_verified",
      "providerMode": "clerk_customer_native_registration_required"
    }
  }
}
